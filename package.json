{
  "name": "@mj_yu/react-generate-page",
  "version": "0.1.37",
  "description": "Generate React pages from your own folder conventions. Config-driven, checks what it generates, zero runtime dependencies.",
  "author": "MyeongJun Yu <y1207cc@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/generate-page.js",
  "bin": "./dist/generate-page.js",
  "files": [
    "dist",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json && node --input-type=module -e \"import{cpSync}from'node:fs';cpSync('tests/fixtures','dist-test/tests/fixtures',{recursive:true})\"",
    "test": "yarn build:test && node --test dist-test/tests/*.test.js",
    "generate:page": "node --experimental-strip-types generate-page.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": "git+https://github.com/YuMyeongJun/react-generate-page.git",
  "bugs": {
    "url": "https://github.com/YuMyeongJun/react-generate-page/issues"
  },
  "homepage": "https://github.com/YuMyeongJun/react-generate-page#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@4.8.1",
  "keywords": [
    "react",
    "generator",
    "scaffold",
    "codegen",
    "boilerplate",
    "cli",
    "template",
    "page",
    "vue",
    "next",
    "remix",
    "plop",
    "hygen"
  ],
  "engines": {
    "node": ">=18"
  }
}
